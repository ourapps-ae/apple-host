  {{scheme}}TV:
    type: application
    platform: tvOS
    sources:
{{sources}}
      - path: {{scheme}}/Resources
        excludes: [Assets.xcassets]
      - {{scheme}}TV/Assets.xcassets
      - path: {{scheme}}/Art
        type: folder
        buildPhase: resources
        optional: true
{{dependencies}}    settings:
      base:
        PRODUCT_BUNDLE_IDENTIFIER: {{bundleIdentifier:json}}
        INFOPLIST_FILE: {{scheme}}TV/Info.plist
        TARGETED_DEVICE_FAMILY: "3"
        "EXCLUDED_ARCHS[sdk=appletvsimulator*]": x86_64
        ASSETCATALOG_COMPILER_APPICON_NAME: AppIcon
        CODE_SIGN_STYLE: Automatic
      configs:
        Release:
          CODE_SIGN_STYLE: Manual
          CODE_SIGN_IDENTITY: Apple Distribution
          DEVELOPMENT_TEAM: "$({{signingPrefix}}_TEAM)"
          PROVISIONING_PROFILE_SPECIFIER: "$({{signingPrefix}}_TV_PROFILE)"
